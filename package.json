{
  "name": "node-js-design-patterns-fourth-edition",
  "version": "1.0.0",
  "type": "module",
  "description": "Code samples for the book Node.js Design Patterns, 4th Edition by Mario Casciaro and Luciano Mammino",
  "scripts": {
    "test": "npm run test:lint",
    "test:lint": "biome check --no-errors-on-unmatched",
    "test:lint-fix": "biome check --fix",
    "prepare": "husky",
    "upd": "npx npm-check-updates -u && npm install"
  },
  "keywords": [
    "node.js",
    "design patterns",
    "book",
    "code samples"
  ],
  "author": "Luciano Mammino and Mario Casciaro",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "*": [
      "npm run test:lint"
    ]
  },
  "dependencies": {
    "mkdirp": "^3.0.1"
  }
}